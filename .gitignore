# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-artifacts/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local runtime and generated review artifacts
/.local-data/
/logs/
/tmp/
/deliverables/
prototype-*.png
__pycache__/
*.pyc

# local Figma MCP scratch files
/package/
/tmp-upload-test/
cursor-talk-to-figma-*.tgz
figma-socket*.log

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
