# App
NODE_ENV=development
NEXT_PUBLIC_WAREHOUSE_SURFACE=local
NEXT_PUBLIC_ALLOW_SURFACE_QUERY=true

# Auth
SESSION_SECRET=replace-with-a-long-random-secret
ALLOW_DEMO_LOGIN=false
ALLOW_DEMO_STAFF_LOGIN=false
CUSTOMER_PASSWORD_RESET_TOKEN=replace-with-a-random-reset-token

# PostgreSQL
# Use either POSTGRES_URL or DATABASE_URL.
POSTGRES_URL=
DATABASE_URL=

# Staff whitelist for production.
# Example:
# STAFF_WHITELIST_JSON=[{"username":"ops@example.com","password":"replace-me","name":"Ops","role":"ops"}]
STAFF_WHITELIST_JSON=

# Optional multi-surface deployment URLs
NEXT_PUBLIC_MARKETING_URL=
NEXT_PUBLIC_CUSTOMER_APP_URL=
NEXT_PUBLIC_ADMIN_URL=
